VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Canonical site URL for meta tags and sitemap (production example: https://www.yourdomain.com)
# Required for correct og:image / canonical URLs when sharing links (e.g. https://ncelektric.vercel.app)
VITE_SITE_URL=http://localhost:5173

# Supabase Edge Function secrets for submit-quote (set in Supabase dashboard → Edge Functions → Secrets)
# SUPABASE_URL=              # Auto-available in Edge runtime
# SUPABASE_SERVICE_ROLE_KEY= # Auto-available in Edge runtime
# SITE_ORIGIN=http://localhost:5173
# RESEND_API_KEY=
# OWNER_QUOTE_EMAIL=owner@example.com
# EMAIL_FROM=NC Elektric <quotes@yourverifieddomain.com>